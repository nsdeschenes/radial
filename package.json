{
  "name": "radial",
  "version": "1.0.0",
  "description": "An old school flight planner for flight sims",
  "keywords": [],
  "license": "MIT",
  "type": "module",
  "main": "src/application/RadialApplication.ts",
  "imports": {
    "#fixtures/*.json": "./fixtures/*.json",
    "#radial/*.js": "./src/*.ts"
  },
  "exports": {
    ".": "./src/application/RadialApplication.ts",
    "./types": "./src/application/RadialApplicationTypes.ts"
  },
  "scripts": {
    "acceptance:benchmark": "nub src/acceptance/runRoutePlannerBenchmark.ts",
    "acceptance:smoke": "nub src/acceptance/checkRoutePlannerSmoke.ts",
    "acceptance:stress": "vitest run src/acceptance/syntheticStressCorpus.test.ts",
    "dev": "node --watch src/radial.ts",
    "start": "node src/radial.ts",
    "check": "nub run fmt:check && nub run lint && nub run typecheck",
    "fix": "nub run fmt && nub run lint:fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:acceptance": "vitest run src/acceptance",
    "test:non-acceptance": "vitest run --exclude 'src/acceptance/**'",
    "test:coverage": "vitest run --coverage --maxWorkers 2",
    "typecheck": "tsc --noEmit",
    "pre-commit:run": "prek run",
    "pre-commit:install": "prek install"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.3",
    "fflate": "^0.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@j178/prek": "^0.4.13",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "msw": "^2.15.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.24.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.4.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.5.0"
    }
  }
}
